---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  // Path of this page, with leading and trailing slash, e.g. "/" or "/results/".
  path: string;
  // Breadcrumb trail after "Home". Empty on the home page.
  crumbs?: { name: string; path: string }[];
  datePublished?: string;
  // True when a full-width photo sits behind the header.
  overlay?: boolean;
  // Practice-area and blog pages credit Bryn Swartz as author, as the old site did.
  author?: boolean;
  // Pages that must stay out of search results even on the live site (404, thank-you).
  noindex?: boolean;
}

const { title, description, path, crumbs = [], datePublished, overlay = false, author = false, noindex = false } = Astro.props;
const origin = Astro.site!.origin;
const url = new URL(path, origin).href;
const image = new URL('/images/open-graph-card.jpg', origin).href;

// Pages are hidden from search engines unless the build says the site is live.
// Previews never set PUBLIC_SITE_LIVE, so they stay hidden by default.
// A page can opt out of the live setting with the noindex prop.
const live = import.meta.env.PUBLIC_SITE_LIVE === '1';
const robots = live && !noindex ? 'max-image-preview:large' : 'noindex, nofollow, max-image-preview:large';

// Structured data: the same four blocks the current site carries on every page.
const trail = [{ name: 'Home', path: '/' }, ...crumbs];
const graph = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumblist`,
    itemListElement: trail.map((c, i) => ({
      '@type': 'ListItem',
      '@id': new URL(c.path, origin).href + (i === trail.length - 1 ? '#listItem' : ''),
      position: i + 1,
      name: c.name,
    })),
  },
  {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: site.name,
    description: site.tagline,
    url: `${origin}/`,
    telephone: '+18045050633',
    logo: {
      '@type': 'ImageObject',
      url: `${origin}/images/brand/logo-horizontal.png`,
      '@id': `${origin}/#organizationLogo`,
      width: 1703,
      height: 522,
    },
    image: { '@id': `${origin}/#organizationLogo` },
    sameAs: site.social.map((s) => s.url),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': `${origin}/#website` },
    breadcrumb: { '@id': `${url}#breadcrumblist` },
    ...(author ? { author: { '@id': `${origin}/#author` }, creator: { '@id': `${origin}/#author` } } : {}),
    ...(datePublished ? { datePublished } : {}),
  },
  // The old author address (/author/brynswartz/) does not exist on the new site,
  // so the author points to Bryn's bio page instead.
  ...(author
    ? [{ '@type': 'Person', '@id': `${origin}/#author`, name: 'Bryn Swartz', url: `${origin}/bryn-swartz/` }]
    : []),
  {
    '@type': 'WebSite',
    '@id': `${origin}/#website`,
    url: `${origin}/`,
    name: site.name,
    description: site.tagline,
    inLanguage: 'en-US',
    publisher: { '@id': `${origin}/#organization` },
  },
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Feed`} href="/feed/" />
    <link rel="icon" href="/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="522" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class:list={[overlay && 'has-overlay']}>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Motion helpers. If anything here fails, the page simply shows normally.
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Header turns solid once the page scrolls past the top.
        var header = document.querySelector('.site-header');
        function onScroll() { header && header.classList.toggle('is-solid', window.scrollY > 40); }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // Dollar amounts count up the first time they appear.
        function countUp(el) {
          var target = parseInt(el.getAttribute('data-count'), 10);
          if (!target || reduce) return;
          var start = null, dur = 1600;
          function step(t) {
            if (start === null) start = t;
            var p = Math.min((t - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = '$' + Math.round(target * eased).toLocaleString('en-US');
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }

        // Fade-up on scroll.
        var els = document.querySelectorAll('[data-reveal], [data-stagger]');
        if (!('IntersectionObserver' in window) || !els.length) return;
        document.documentElement.classList.add('js');
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            e.target.querySelectorAll('[data-count]').forEach(countUp);
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
