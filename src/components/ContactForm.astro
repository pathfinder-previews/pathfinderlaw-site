---
// The contact form, used by the homepage, the Contact page and the section
// forms on every other page. It posts JSON to /api/contact (the Worker in
// src/worker/). See docs/form-pipeline.md.
import { site } from '../data/site';

const { id = 'contact-form' } = Astro.props;

// Turnstile public site key, supplied at build time. Cloudflare's published
// always-pass test key is used for previews. A live build without the real
// key fails here instead of quietly shipping the test key.
const TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
if (!siteKey && import.meta.env.PUBLIC_SITE_LIVE === '1') {
  throw new Error('PUBLIC_TURNSTILE_SITE_KEY must be set for a live build (see docs/form-pipeline.md).');
}
---
<div class="form-card">
  <h3>Talk With Us</h3>
  <form class="contact-form" id={id} method="post" action="/contact/" novalidate data-sitekey={siteKey || TEST_SITE_KEY} data-phone={site.phoneHeader} data-phone-href={site.phoneHref}>
    <div class="field">
      <label for={`${id}-name`}>Name<span aria-hidden="true">*</span></label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field-pair">
      <div class="field">
        <label for={`${id}-email`}>Email<span aria-hidden="true">*</span></label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for={`${id}-phone`}>Phone Number<span aria-hidden="true">*</span></label>
        <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" required />
      </div>
    </div>
    <div class="field">
      <label for={`${id}-message`}>Message<span aria-hidden="true">*</span></label>
      <textarea id={`${id}-message`} name="message" required></textarea>
      <p class="field-hint">Please keep this short. Do not include confidential or sensitive details yet.</p>
    </div>
    <!-- Required acknowledgement (ethics review, LEO 1842). Wording drafted with the owner and approved by him. -->
    <div class="consent">
      <input id={`${id}-consent`} name="acknowledged" type="checkbox" required />
      <label for={`${id}-consent`}>
        I understand sending this form does not make me a client or create an attorney-client relationship, and Pathfinder Injury Law has not agreed to represent me.<span aria-hidden="true">*</span>
      </label>
    </div>
    <!-- Spam trap: people never see this field, bots fill it in. -->
    <div class="hp" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div class="ts-widget"></div>
    <button class="btn btn-primary" type="submit">Send Inquiry</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
  // Loaded only on pages that contain the form (Astro includes this script only
  // where the component is used). Cloudflare's Turnstile script is NOT loaded
  // with the page: it loads the first time the visitor interacts with a form
  // (focus, tap or typing), or when they press Send. This keeps the privacy
  // policy true ("runs in the background when You use the form").
  type TurnstileApi = { render(el: Element, opts: Record<string, unknown>): string; reset(id?: string): void };
  const forms = document.querySelectorAll<HTMLFormElement>('.contact-form');
  const pageLoaded = Date.now();
  const kind = location.pathname === '/' || location.pathname === '/contact/' ? 'main' : 'sidebar';
  const TS_URL = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  const TOKEN_WAIT_MS = 60_000;

  // One shared load for every form on the page. Resolves with the API, or null if blocked.
  let tsLoad: Promise<TurnstileApi | null> | undefined;
  const loadTurnstile = () =>
    (tsLoad ??= new Promise((resolve) => {
      const ready = (window as any).turnstile as TurnstileApi | undefined;
      if (ready) return resolve(ready);
      const s = document.createElement('script');
      s.src = TS_URL;
      s.async = true;
      s.onload = () => resolve(((window as any).turnstile as TurnstileApi) ?? null);
      s.onerror = () => resolve(null);
      document.head.appendChild(s);
    }));

  forms.forEach((form) => {
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const widget = form.querySelector('.ts-widget') as HTMLElement;
    let token = '';
    let failed = false;
    let sending = false;
    let widgetId: string | undefined;
    let started: Promise<void> | undefined;
    let waiters: ((ok: boolean) => void)[] = [];
    const settle = (ok: boolean) => {
      const w = waiters;
      waiters = [];
      w.forEach((fn) => fn(ok));
    };

    // Load Turnstile (once) and render this form's widget (once).
    const start = () =>
      (started ??= loadTurnstile().then((ts) => {
        if (!ts) {
          failed = true;
          return settle(false);
        }
        widgetId = ts.render(widget, {
          sitekey: form.dataset.sitekey,
          callback: (t: string) => {
            token = t;
            failed = false;
            settle(true);
          },
          'expired-callback': () => (token = ''),
          'error-callback': () => {
            failed = true;
            token = '';
            settle(false);
          },
        });
      }));

    // First interaction with this form starts the check.
    const onFirst = () => {
      start();
      for (const ev of ['focusin', 'pointerdown', 'input']) form.removeEventListener(ev, onFirst);
    };
    for (const ev of ['focusin', 'pointerdown', 'input']) form.addEventListener(ev, onFirst);

    // Resolves true once a token is ready, false if the check failed or took too long.
    const waitForToken = (): Promise<boolean> => {
      if (token) return Promise.resolve(true);
      if (failed) return Promise.resolve(false);
      return new Promise((resolve) => {
        const timer = setTimeout(() => {
          waiters = waiters.filter((w) => w !== done);
          resolve(false);
        }, TOKEN_WAIT_MS);
        const done = (ok: boolean) => {
          clearTimeout(timer);
          resolve(ok);
        };
        waiters.push(done);
        start();
      });
    };

    const showFailure = () => {
      status.textContent = 'We could not send your message. Please call us at ';
      const a = document.createElement('a');
      a.href = form.dataset.phoneHref || '';
      a.textContent = form.dataset.phone || '';
      status.append(a, ' and we will help you right away.');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return; // no double submission
      if (!form.checkValidity()) {
        status.textContent = 'Please fill in every field marked with a star, including the acknowledgement.';
        form.reportValidity();
        start();
        return;
      }
      sending = true;
      button.disabled = true;
      let leaving = false;
      try {
        if (!token) {
          status.textContent = 'One moment, we are checking your browser...';
          const ok = await waitForToken();
          if (!ok) {
            if (failed) showFailure();
            else status.textContent = 'Please complete the check above, then press Send Inquiry again.';
            return;
          }
        }
        const data = new FormData(form);
        status.textContent = 'Sending...';
        const sentToken = token;
        token = ''; // a token works once
        let res: Response;
        try {
          res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              name: data.get('name'),
              email: data.get('email'),
              phone: data.get('phone'),
              message: data.get('message'),
              acknowledged: data.get('acknowledged') === 'on',
              company: data.get('company'),
              form: kind,
              fillMs: Date.now() - pageLoaded,
              turnstileToken: sentToken,
            }),
          });
        } catch {
          showFailure();
          (window as any).turnstile?.reset(widgetId);
          return;
        }
        const result = await res.json().catch(() => ({}));
        if (res.ok && result.ok) {
          if (result.preview) {
            status.textContent = result.message || 'Preview: nothing was sent.';
            (window as any).turnstile?.reset(widgetId);
            return;
          }
          leaving = true; // keep the button off while the thank-you page loads
          location.href = '/thank-you/';
          return;
        }
        if (res.status === 400) {
          status.textContent = 'Please check that every field is filled in correctly and the acknowledgement is checked.';
        } else {
          showFailure();
        }
        (window as any).turnstile?.reset(widgetId);
      } finally {
        if (!leaving) {
          sending = false;
          button.disabled = false;
        }
      }
    });
  });
</script>
