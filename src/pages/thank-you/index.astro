---
import InfoPage from '../../components/InfoPage.astro';
import { site } from '../../data/site';

// Form confirmation page. Must stay out of search results and out of the sitemap:
// the X-Robots-Tag header in public/_headers handles search engines at launch, and the sitemap
// files (built later) must leave this address out. Wording is the live page's, unchanged.
const title = 'Thank You - Pathfinder Injury Law';
const description =
  "Pathfinder Injury Law offers a 100% free consultation with no pressure and no hidden fees. Let's discuss your Virginia workers' comp case.";
---
<InfoPage title={title} description={description} path="/thank-you/" h1="Thank You" showContact={false} noindex>
  <p class="lead">
    We will get back to you shortly. If you’d like to contact us immediately, please call our office
    at <a href={site.phoneHref}>{site.phoneDisplay}</a>.
  </p>
  <p><a class="btn btn-primary" href="/">Back To Home</a></p>
</InfoPage>
