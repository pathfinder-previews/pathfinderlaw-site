{
  // Must match the Worker name chosen in the Cloudflare dashboard.
  "name": "pathfinderlaw-site",
  "compatibility_date": "2026-10-27",
  // The live site is reached only at pathfinderlaw.com. Turn off the
  // extra *.workers.dev address and per-version preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Worker code handles only /api/* (the contact form) and the scheduled jobs.
  // See docs/form-pipeline.md.
  "main": "src/worker/index.ts",
  // Serve the built site as static files. Only /api/* runs Worker code, so
  // every page stays a free, fast static file.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Form log (production account "Pathfinder Injury Law"). IDs are not secrets.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pathfinder-forms",
      "database_id": "9f7c86d0-7826-43cb-9409-a73f648ebecd",
      "migrations_dir": "migrations"
    }
  ],
  // Screening rules live here (key "rules"), not in the public repository.
  "kv_namespaces": [
    { "binding": "SETTINGS", "id": "9cfc276b5526434ea88e48547b257fa0" }
  ],
  // Plain settings (not secret). ALLOWED_HOSTNAMES: the sites a Turnstile token
  // may come from, comma-separated. For the launch test, add the locked test
  // hostname here, deploy, test, then remove it. Change it here, not in the
  // dashboard: each deploy resets plain variables to what this file says.
  "vars": {
    "ALLOWED_HOSTNAMES": "pathfinderlaw.com,www.pathfinderlaw.com"
  },
  // Cron runs in UTC. 12:15 and 12:30 UTC are 7:15 and 7:30 a.m. Eastern
  // standard time (winter). In daylight time (from March 14, 2027) change
  // only the hours here, 12 to 11 ("15 11 * * *" and "30 11 * * *"). That is
  // the only change needed: the code picks the job by the minute (15 = morning
  // self-test, 30 = digest and purge), so keep the minutes 15 and 30.
  "triggers": {
    "crons": ["15 12 * * *", "30 12 * * *"]
  }
  // Secrets, added in the dashboard and never written here:
  //   GOOGLE_SA_KEY, TURNSTILE_SECRET, HEARTBEAT_URL, ALERT_URL
}
